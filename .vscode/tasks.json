{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: create .venv and install requirements",
      "type": "shell",
      "command": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
      "windows": {"command": "py -m venv .venv; .venv\\Scripts\\python -m pip install -r requirements.txt"},
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
